# ============================================
# 404ISLANDS POSTGRESQL DATABASE CONFIGURATION
# ============================================

# Database Connection
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="archipelago"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_secure_password_123"
POSTGRES_SSL="false"

# JWT Configuration
JWT_SECRET="404islands-jwt-secret-key-change-in-production"
JWT_EXPIRES_IN="24h"

# Connection Pool Settings
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=20
POSTGRES_POOL_ACQUIRE=30000
POSTGRES_POOL_IDLE=10000

# Database Initialization Flags
SEED_SAMPLE_DATA="true"
RECORDED_COLLECTIONS="false"
RUN_DIAGNOSTICS="true"
KEEP_ALIVE="false"

# Advanced Features
JSON_SCHEMA_VALIDATION="true"
ENCRYPT_SENSITIVE_DATA="true"
ENABLE_AUTOMATED_BACKUPS="true"
BCRYPT_ROUNDS=12

# Development/Production Mode
NODE_ENV="development"