# ============================================
# ARCHIPELAGO ORACLE DATABASE CONFIGURATION
# ============================================

# Database Connection
ORACLE_CONNECTION_STRING="adb.region.oraclecloud.com:1521/database_databaseid_low.adb.oraclecloud.com"
ORACLE_USER="admin"
ORACLE_PASSWORD="your_secure_password_123"

# Optional: Oracle Wallet for enhanced security
# ORACLE_WALLET_PATH="/path/to/wallet/directory"
# ORACLE_WALLET_PASSWORD="wallet_password_if_encrypted"

# JWT Configuration
JWT_SECRET="archipelago-jwt-secret-key-change-in-production"
JWT_EXPIRES_IN="24h"

# Connection Pool Settings
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=20
ORACLE_POOL_INCREMENT=2
ORACLE_CONNECT_TIMEOUT=15
ORACLE_RECONNECT_TRIES=3

# Database Initialization Flags
SEED_SAMPLE_DATA="true"
RECORDED_COLLECTIONS="false"
RUN_DIAGNOSTICS="true"
KEEP_ALIVE="false"

# Advanced Features
JSON_SCHEMA_VALIDATION="true"
ENCRYPT_SENSITIVE_DATA="true"
ENABLE_AUTOMATED_BACKUPS="true"
BCRYPT_ROUNDS=12

# Development/Production Mode
NODE_ENV="development"

# ============================================
# ENVIRONMENT SETUP INSTRUCTIONS
# ============================================

# 1. Create a copy of this file:
#    cp .env.example .env

# 2. Fill in your Oracle Autonomous JSON Database credentials:
#    - Get connection string from Oracle Cloud Console
#    - Create admin user with necessary permissions
#    - Use strong, unique password

# 3. For production:
#    - Use environment-specific .env files
#    - Store secrets in secure key management (AWS KMS, Azure Key Vault, etc.)
#    - Enable Oracle Wallet authentication for maximum security
#    - Set JWT_SECRET to a cryptographically secure random string

# 4. Optional Oracle Wallet Setup:
#    - Download wallet from Oracle Cloud Console
#    - Extract to secure directory
#    - Set ORACLE_WALLET_PATH to absolute path
#    - If wallet is encrypted, provide ORACLE_WALLET_PASSWORD

# ============================================
# EXAMPLE PRODUCTION VALUES
# ============================================

# Production connection example:
# ORACLE_CONNECTION_STRING="(DESCRIPTION=(RETRY_COUNT=20)(RETRY_DELAY=3)(ADDRESS=(PROTOCOL=TCPS)(PORT=1521)(HOST=adb-prod.us-ashburn-1.oraclecloud.com))(CONNECT_DATA=(SERVICE_NAME=databaseid.adb.oraclecloud.com))(SECURITY=(MY_WALLET_DIRECTORY=/opt/oracle/wallet)))"
# ORACLE_USER="archipelago_prod"
# ORACLE_WALLET_PATH="/opt/oracle/wallet"
# JWT_SECRET="super_secure_production_jwt_secret_512_chars_minimum"#
# ORACLE_POOL_MAX=100  # Higher for production load
# NODE_ENV="production"

# ============================================
# TROUBLESHOOTING
# ============================================

# If you encounter connection errors:
# 1. Verify connection string format
# 2. Check network connectivity and firewall rules
# 3. Ensure database is in "Available" state in Oracle Cloud Console
# 4. Validate user credentials and permissions

# For production deployment:
# - Use connection pooling parameters optimized for your workload
# - Implement health check endpoints for monitoring
# - Set up automated backup and recovery procedures
# - Enable Oracle Data Safe for security monitoring

# ============================================
# SECURITY REMINDERS
# ============================================

# NEVER commit .env files to version control
# Use different credentials for development/production
# Regularly rotate passwords and JWT secrets
# Enable Multi-Factor Authentication where possible
# Monitor database access logs regularly

# ============================================
# PERFORMANCE TUNING
# ============================================

# For high-traffic scenarios:
# - Increase ORACLE_POOL_MAX based on concurrent user load
# - Use Oracle Wallet for faster, more secure connections
# - Enable advanced networking features (ONS, Fast Application Notification)
# - Implement connection multiplexing at the application layer